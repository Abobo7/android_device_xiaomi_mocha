diff --git a/libs/hwui/renderthread/EglManager.cpp b/libs/hwui/renderthread/EglManager.cpp
index 16d77364..ba39c694 100644
--- a/libs/hwui/renderthread/EglManager.cpp
+++ b/libs/hwui/renderthread/EglManager.cpp
@@ -34,6 +34,14 @@
 #include <GrContextOptions.h>
 #include <gl/GrGLInterface.h>
 
+// Tegra's default display cannot be rebuilt after eglTerminate followed by
+// eglReleaseThread. Keep only the thread state; still release the display,
+// context and pbuffer on trim. Other drivers retain the upstream teardown.
+static bool eglSkipReleaseThread() {
+    static bool value = property_get_bool("ro.egl.skip_release_thread", false);
+    return value;
+}
+
 #ifdef HWUI_GLES_WRAP_ENABLED
 #include "debug/GlesDriver.h"
 #endif
@@ -335,7 +343,9 @@ void EglManager::destroy() {
     eglDestroySurface(mEglDisplay, mPBufferSurface);
     eglMakeCurrent(mEglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
     eglTerminate(mEglDisplay);
-    eglReleaseThread();
+    if (!eglSkipReleaseThread()) {
+        eglReleaseThread();
+    }
 
     mEglDisplay = EGL_NO_DISPLAY;
     mEglContext = EGL_NO_CONTEXT;
