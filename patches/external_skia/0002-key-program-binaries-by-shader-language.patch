+static sk_sp<SkData> make_persistent_cache_key(const GrProgramDesc& desc,
+                                             const GrGLContextInfo& context) {
+    // Program descriptors are local to a context and do not identify the shader
+    // language. Persistent binaries can outlive that context (or a library
+    // update), so distinguish both GL/GLES and the selected GLSL generation.
+    // The tag also separates these keys from the old, unprefixed descriptors.
+    const uint32_t shaderKey[] = {SkSetFourByteTag('G', 'L', 'P', 'C'),
+                                 static_cast<uint32_t>(context.standard()),
+                                 static_cast<uint32_t>(context.glslGeneration())};
+    sk_sp<SkData> key = SkData::MakeUninitialized(sizeof(shaderKey) + desc.keyLength());
+    auto* bytes = static_cast<uint8_t*>(key->writable_data());
+    memcpy(bytes, shaderKey, sizeof(shaderKey));
+    memcpy(bytes + sizeof(shaderKey), desc.asKey(), desc.keyLength());
+    return key;
+}
