diff --git a/src/gpu/gl/GrGLContext.cpp b/src/gpu/gl/GrGLContext.cpp
index dd774cd76d..4a0d72cb4c 100644
--- a/src/gpu/gl/GrGLContext.cpp
+++ b/src/gpu/gl/GrGLContext.cpp
@@ -56,6 +56,20 @@ std::unique_ptr<GrGLContext> GrGLContext::Make(sk_sp<const GrGLInterface> interf
     GrGLGetDriverInfo(interface->fStandard, args.fVendor, renderer, ver,
                       &args.fDriver, &args.fDriverVersion);
 
+    // Older NVIDIA GLES drivers advertise ES 3.x but only provide the ESSL 1.00
+    // external-image extension. Selecting an ES 3.x shader language makes
+    // GrGLCaps disable external textures, so AHardwareBuffer-backed images are
+    // silently rejected by check_backend_texture(). Keep the GLES context and
+    // GPU renderer, but use the shader language that can sample these images.
+    if (kGLES_GrGLStandard == interface->fStandard &&
+        kNVIDIA_GrGLVendor == args.fVendor &&
+        args.fGLSLGeneration > k110_GrGLSLGeneration &&
+        interface->fExtensions.has("GL_OES_EGL_image_external") &&
+        !interface->fExtensions.has("GL_OES_EGL_image_external_essl3") &&
+        !interface->fExtensions.has("OES_EGL_image_external_essl3")) {
+        args.fGLSLGeneration = k110_GrGLSLGeneration;
+    }
+
     args.fContextOptions = &options;
     args.fInterface = std::move(interface);
 
