+// Legacy factory readers may omit leading zeros and append a line ending.
+// Parse exactly six one/two-digit hex octets; never invent or change identity.
+static bool parse_legacy_bdaddr(const char* text, uint8_t* address) {
+  uint8_t bytes[6];
+  const char* p = text;
+  if (p == nullptr) return false;
+  for (size_t i = 0; i < sizeof(bytes); ++i) {
+    if (!isxdigit(static_cast<unsigned char>(*p))) return false;
+    char* end = nullptr;
+    unsigned long value = strtoul(p, &end, 16);
+    if (end - p < 1 || end - p > 2 || value > 255) return false;
+    bytes[i] = static_cast<uint8_t>(value);
+    p = end;
+    if (i != sizeof(bytes) - 1 && *p++ != ':') return false;
+  }
+  if (*p == '\r') ++p;
+  if (*p == '\n') ++p;
+  if (*p != '\0') return false;
+  const uint8_t zero[6] = {};
+  const uint8_t broadcast[6] = {255, 255, 255, 255, 255, 255};
+  if (!memcmp(bytes, zero, 6) || !memcmp(bytes, broadcast, 6)) return false;
+  memcpy(address, bytes, sizeof(bytes));
+  return true;
+}
