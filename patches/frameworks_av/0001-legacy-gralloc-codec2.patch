diff --git a/apex/ld.config.txt b/apex/ld.config.txt
index af8ec06..eb80522 100644
--- a/apex/ld.config.txt
+++ b/apex/ld.config.txt
@@ -131,3 +131,11 @@ namespace.sphal.link.platform.shared_libs = libEGL.so:libGLESv1_CM.so:libGLESv2.
 
 # Add a link for libz.so which is llndk on devices where VNDK is not enforced.
 namespace.sphal.link.platform.shared_libs += libz.so
+
+# Mocha has no separate VNDK-SP installation. Its gralloc0 mapper, NVIDIA
+# libraries and the libcutils atomic shim must share a dependency group.
+# Retain namespace isolation and the existing LLNDK links while using the
+# platform library directory for these legacy SP-HAL dependencies.
+namespace.sphal.search.paths += /system/${LIB}
+namespace.sphal.asan.search.paths += /data/asan/system/${LIB}
+namespace.sphal.asan.search.paths += /system/${LIB}
