--- a/Android.mk
+++ b/Android.mk
@@ -20,6 +20,11 @@ include $(CLEAR_VARS)
 
 LOCAL_SRC_FILES := nvpowerhal.cpp timeoutpoker.cpp power.cpp powerhal_utils.cpp tegra_sata_hal.cpp
 
+# Keep legacy diagnostics visible without letting Android 9 Clang reject this pinned HAL.
+LOCAL_CPPFLAGS += -Wno-error=gnu-designator
+LOCAL_CPPFLAGS += -Wno-error=unused-function -Wno-error=unused-parameter \
+                  -Wno-error=unused-variable -Wno-error=unused-private-field
+
 # This is only for devices that can contain a sata hard drive, currently only foster
 ifneq ($(filter foster,$(TARGET_DEVICE)),)
 LOCAL_CFLAGS += -DENABLE_SATA_STANDBY_MODE
