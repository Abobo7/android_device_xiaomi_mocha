# mocha-specific policy for conn_init (real wifi/bt MAC loader)

type conn_wifi, domain;
type conn_wifi_exec, exec_type, file_type;

init_daemon_domain(conn_wifi)

# Read the BKB partition that holds the real MACs
allow conn_wifi block_device:dir search;
allow conn_wifi wifi_data_file:dir rw_dir_perms;
allow conn_wifi wifi_data_file:file create_file_perms;
allow conn_wifi bluetooth_data_file:dir rw_dir_perms;
allow conn_wifi bluetooth_data_file:file create_file_perms;
allow conn_wifi factory_file:dir r_dir_perms;
allow conn_wifi factory_file:file r_file_perms;
allow conn_wifi self:capability { dac_override net_admin };
allow conn_wifi shell_exec:file rx_file_perms;
allow conn_wifi sysfs_wifi:file rw_file_perms;
