# mocha-specific policy for NVIDIA unified system scaling

type ussrd, domain;
type ussrd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(ussrd)

# Read sysfs cpufreq / cpuquiet nodes it publishes
r_dir_file(ussrd, sysfs_devices_system_cpu)
allow ussrd sysfs:dir search;
allow ussrd sysfs:file rw_file_perms;
allow ussrd debugfs_clock:dir search;
allow ussrd debugfs_clock:file w_file_perms;
allow ussrd self:capability { sys_admin };

# Consume the thermal paths published by the original setup script.
get_prop(ussrd, thermal_prop)
r_dir_file(ussrd, sysfs_thermal)
