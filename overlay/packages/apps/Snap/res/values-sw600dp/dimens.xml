<?xml version="1.0" encoding="utf-8"?>
<!--
     The sw600dp layout puts the shutter button below the bottom of the
     controls area (shutter_offset = -33dp), which clips half of the button
     on fullscreen tablets. Use the same offset as the default layout.
-->
<resources>
    <dimen name="shutter_offset">11dp</dimen>
</resources>
