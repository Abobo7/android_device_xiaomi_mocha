<resources>

<!-- All the capabilities of the LEDs on this device, stored as a bit field.
         Values are defined in LightsCapabilities.java.
         The LP5521 provides an RGB notification light, an RGB battery light
         and a battery (charging) light, and supports pulsing, so:
         LIGHTS_RGB_NOTIFICATION_LED = 1
         LIGHTS_RGB_BATTERY_LED = 2
         LIGHTS_PULSATING_LED = 8
         LIGHTS_BATTERY_LED = 64
         The previous value 11 omitted LIGHTS_BATTERY_LED, so
         LineageBatteryLights.isSupported() returned false and the charging
         indicator never ran. -->
    <integer name="config_deviceLightCapabilities" translatable="false">75</integer>

</resources>
