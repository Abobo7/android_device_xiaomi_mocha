on early-init
    export TOUCH_CONF_DIR /data/touchscreen
    export TOUCH_DATA_DIR /data/touchscreen
    export MPU_DATA_DIR /data/misc/mpu
    export MPU_CONF_DIR /mnt/factory/mpu

on post-fs-data
    mkdir /mnt/usercalib/touchscreen 0755 system system
    symlink /mnt/usercalib/touchscreen /data/misc/touchscreen
    mkdir /mnt/usercalib/mpu 0755 system system
    symlink /mnt/usercalib/mpu /data/misc/mpu
